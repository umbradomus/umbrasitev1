# Copy this file to worker/.dev.vars and fill it in. .dev.vars is git-ignored.
# These two are the only secrets the Worker has.

# Anything long and random. This is the only thing between the internet and
# Drew's list of customers. Generate one you will not have to remember:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=change-me-to-something-long-and-random

# The ntfy.sh topic the 90-minute nudge is pushed to. The topic name IS the
# password — anyone who knows it can read the pushes. Make it long and odd,
# e.g. umbra-intake-7f3k9qz2x. Subscribe to the same name in the ntfy Android app.
NTFY_TOPIC=umbra-intake-change-me

# --- local testing only, never set in production ----------------------------
# Opens POST /__run-nudge so the cron body can be fired on demand.
ALLOW_TEST_HOOKS=false
